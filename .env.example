# frontier-tether-qvac Environment Variables
# Copy to .env.local and fill in values

# URL for the local QVAC SDK backend (e.g., http://127.0.0.1:8000/api)
NEXT_PUBLIC_QVAC_API_URL=

# QVAC API Key
# You can obtain this API key from the Tether account settings: https://app.tether.to/app/account/settings/api-keys
# Note: 2FA is required to access and generate API keys.
QVAC_API_KEY=
